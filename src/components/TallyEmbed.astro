---
/**
 * Params verified against https://tally.so/embed/gDqDA4:
 *  - transparentBackground: inherit the page background in both themes
 *  - dynamicHeight: no hardcoded pixel height
 *  - hideTitle: avoids repeating the page heading
 */
import { TALLY_FORM_ID } from '../config';

const src = `https://tally.so/embed/${TALLY_FORM_ID}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1`;

const { t } = Astro.locals.i18n;
---


<div class="mt-[2em]">
  <iframe
    data-tally-src={src}
    title={t('contact.formTitle')}
    width="100%"
    height="400"
    loading="lazy"
    class="min-h-[400px] w-full border-0"
  ></iframe>
</div>

<script is:inline src="https://tally.so/embed/js" defer></script>
<script is:inline>
  // Deferred scripts run before DOMContentLoaded, so the embed is ready by then.
  window.addEventListener('DOMContentLoaded', () => window.Tally?.loadEmbeds());
</script>

---
/**
 * Glyphs swap purely in CSS via the `light:` variant, so the button is correct
 * even if this script never runs. JS only maintains the accessible name, reading
 * both variants from data-* so the copy stays in the dictionary.
 */
import Icon from './Icon.astro';

const { t } = Astro.locals.i18n;
---


<button
  type="button"
  id="theme-toggle"
  title={t('theme.toggle')}
  aria-label={t('theme.toLight')}
  data-label-to-light={t('theme.toLight')}
  data-label-to-dark={t('theme.toDark')}
  class="grid h-[2em] w-[2em] cursor-pointer place-items-center rounded-[5px] transition-colors duration-200 active:bg-hairline-soft pointer-coarse:min-h-[44px] pointer-coarse:min-w-[44px]"
>
  <Icon name="lucide:sun" class="size-[0.95em] light:hidden" />
  <Icon name="lucide:moon" class="hidden size-[0.95em] light:inline-flex" />
</button>

<script>
  const btn = document.getElementById('theme-toggle') as HTMLButtonElement | null;

  if (btn) {
    const toLight = btn.dataset.labelToLight ?? '';
    const toDark = btn.dataset.labelToDark ?? '';

    const sync = () => {
      const light = document.documentElement.classList.contains('light');
      const next = light ? toDark : toLight;
      btn.setAttribute('aria-label', next);
      btn.setAttribute('title', next);
    };

    sync();

    btn.addEventListener('click', () => {
      document.documentElement.classList.toggle('light');
      try {
        localStorage.setItem(
          'ensis-theme',
          document.documentElement.classList.contains('light') ? 'light' : 'dark',
        );
      } catch {
        /* storage blocked — toggle still works for this page view */
      }
      sync();
    });
  }
</script>

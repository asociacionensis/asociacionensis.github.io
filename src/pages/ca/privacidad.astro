---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Content, frontmatter } from '../../content/legal/privacitat-ca.md';
import { formatDate } from '../../utils/date';

const { locale, t } = Astro.locals.i18n;

const title = 'Política de privadesa';
const updated = formatDate(locale, new Date(frontmatter.updated));
---

<BaseLayout title={`${title} — Asociación Ensis`} bannerAs="p">
  <div class="prose max-w-none">
    <h1>{title}</h1>
    <p class="text-ink-muted">{t('legal.lastUpdated', { date: updated })}</p>
    <Content />
  </div>
</BaseLayout>
